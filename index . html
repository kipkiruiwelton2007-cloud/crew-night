<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Crew Night</title>
<style>
:root{--bg:#F6F2FB;--ink:#1A1530;--card:#FFFFFF;--mut:#5E5879;--line:#D9D0EC;--acc:#B82A72;--on:#FFFFFF;--good:#0B7A6F;--soft:#EFE8FA;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#120F24;--ink:#F1ECFF;--card:#1C1838;--mut:#A9A3C8;--line:#363160;--acc:#FF6AAE;--on:#1B0A14;--good:#46DCC9;--soft:#27224A;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#120F24;--ink:#F1ECFF;--card:#1C1838;--mut:#A9A3C8;--line:#363160;--acc:#FF6AAE;--on:#1B0A14;--good:#46DCC9;--soft:#27224A;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:34rem;margin:0 auto;padding:20px 16px 40px}
h1{font:800 2rem/1.1 "Avenir Next","Trebuchet MS",system-ui,sans-serif;margin:8px 0 4px;letter-spacing:-.02em}
h2{font:700 1.1rem/1.2 "Avenir Next","Trebuchet MS",system-ui,sans-serif;margin:0 0 12px}
.sub{margin:0 0 20px;color:var(--mut)}
section{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:16px}
label{display:block;font-size:.85rem;color:var(--mut);margin:10px 0 4px}
input,select{width:100%;font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:11px 12px}
input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.band{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:2px solid var(--acc);border-radius:14px;overflow:hidden}
.band button{border:0;border-right:2px dashed var(--acc);background:transparent;color:var(--ink);font-family:inherit;font-weight:700;font-size:1rem;line-height:1.2;padding:18px 6px;min-height:78px;cursor:pointer}
.band button:last-child{border-right:0}
.band button small{display:block;font-weight:500;color:var(--mut);margin-top:4px}
.band button.done{background:var(--acc);color:var(--on)}
.band button.done small{color:var(--on)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:var(--bg);color:var(--ink);font-family:inherit;font-weight:600;font-size:.9rem;line-height:1;padding:11px 13px;border-radius:999px;cursor:pointer}
.chip.on{background:var(--acc);color:var(--on);border-color:var(--acc)}
.q{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-top:1px solid var(--line)}
.q input{width:22px;height:22px;margin:1px 0 0;padding:0;accent-color:var(--acc);flex:none}
.q label{margin:0;font-size:1rem;color:var(--ink);flex:1}
.btn{font-family:inherit;font-weight:700;font-size:.95rem;line-height:1;border:0;border-radius:10px;padding:12px 14px;background:var(--acc);color:var(--on);cursor:pointer;text-decoration:none;display:inline-block}
.btn.alt{background:var(--soft);color:var(--ink)}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:14px}
.out{display:none;margin-top:14px;background:var(--soft);border-radius:12px;padding:12px}
.out p{margin:0 0 10px;word-break:break-word}
ul{list-style:none;margin:12px 0 0;padding:0}
li{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid var(--line)}
li button{background:none;border:0;color:var(--mut);font:inherit;cursor:pointer;text-decoration:underline}
.pts{font-weight:700;color:var(--good)}
.note{font-size:.85rem;color:var(--mut);margin:0}
.settle{margin-top:12px;font-weight:600}
.bar{height:8px;background:var(--soft);border-radius:8px;overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:var(--good);width:0}
.bar.over i{background:var(--acc)}
</style>
</head>
<body>
<main>
<h1>Crew Night</h1>
<p class="sub">Plan it, tap it, get everyone home.</p>

<section>
<h2>Tonight's pact</h2>
<div class="two">
<div><label for="crew">Crew name</label><input id="crew" autocomplete="off" placeholder="Kikosi"></div>
<div><label for="me">Your name</label><input id="me" autocomplete="off" placeholder="Wanjiku"></div>
</div>
<label for="members">Everyone in the crew (separate names with commas)</label>
<input id="members" autocomplete="off" placeholder="Brian, Achieng, Kevin">
<label for="venue">Where are you going?</label>
<input id="venue" autocomplete="off" placeholder="Venue or area">
<div class="two">
<div><label for="budget">Crew budget (KES)</label><input id="budget" inputmode="numeric" placeholder="5000"></div>
<div><label for="home">Home by</label><input id="home" autocomplete="off" placeholder="2:00 am"></div>
</div>
<label for="anchor">Tonight's anchor</label>
<select id="anchor"></select>
<p class="note" style="margin-top:8px">The anchor stays alert, watches the group's drinks, and makes sure nobody leaves alone. Rotate it every outing.</p>
</section>

<section>
<h2>Your night</h2>
<div class="band" id="band"></div>
<div class="out" id="out">
<p id="msg"></p>
<div class="row" style="margin-top:0">
<a class="btn" id="wa" target="_blank" rel="noopener">Send to crew chat</a>
<button class="btn alt" id="copy" type="button">Copy message</button>
</div>
</div>
<div class="row">
<button class="btn" id="all" type="button">Everyone is home</button>
<span class="pts" id="pts"></span>
</div>
<div class="row"><button class="btn alt" id="reset" type="button">Start a new night</button></div>
</section>

<section>
<h2>What kind of outing?</h2>
<div class="chips" id="kinds"></div>
<p class="note" style="margin-top:8px">Your pick appears in your check-in messages.</p>
</section>

<section>
<h2>Crew quests</h2>
<p class="note">Finish quests together to earn crew points. No drinking challenges.</p>
<div id="quests"></div>
<p class="pts" id="qpts" style="margin:10px 0 0"></p>
</section>

<section>
<h2>Who does what?</h2>
<p class="note">Let the app choose, so nobody argues.</p>
<div class="chips" id="roles" style="margin-top:10px"></div>
<p class="settle" id="pick"></p>
</section>

<section>
<h2>Song queue</h2>
<div class="two">
<div><label for="song">Song and artist</label><input id="song" autocomplete="off" placeholder="Song - Artist"></div>
<div><label for="by">Requested by</label><select id="by"></select></div>
</div>
<div class="row"><button class="btn" id="addsong" type="button">Add to queue</button><button class="btn alt" id="shsong" type="button">Share queue</button></div>
<ul id="songs"></ul>
</section>

<section>
<h2>Split the costs</h2>
<label for="what">What was it?</label>
<input id="what" autocomplete="off" placeholder="Cab, drinks, entry">
<div class="two">
<div><label for="amt">Amount (KES)</label><input id="amt" inputmode="numeric" placeholder="1200"></div>
<div><label for="payer">Who paid?</label><select id="payer"></select></div>
</div>
<div class="row"><button class="btn" id="add" type="button">Add cost</button></div>
<div class="bar" id="bar"><i></i></div>
<p class="note" id="spent" style="margin-top:6px"></p>
<ul id="list"></ul>
<div class="settle" id="settle"></div>
</section>

<p class="note">For ages 18 and over. Crew Night helps friends coordinate; it cannot keep anyone safe. In an emergency call 999 or 112. Your crew details stay on this phone.</p>
</main>

<script>
(function(){
var KEY='crewnight.v1',$=function(s){return document.querySelector(s)};
var S={crew:'',me:'',members:'',venue:'',budget:'',home:'',anchor:'',log:[],exp:[],pts:0,kind:'',q:[],songs:[],qp:0};
try{var r=localStorage.getItem(KEY);if(r)S=Object.assign(S,JSON.parse(r))}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
function people(){var l=S.members.split(',').map(function(x){return x.trim()}).filter(Boolean),m=S.me.trim();
 if(m&&!l.some(function(x){return x.toLowerCase()===m.toLowerCase()}))l.unshift(m);return l}
function kes(n){return 'KES '+Math.round(n).toLocaleString()}
function now(){return new Date().toLocaleTimeString([],{hour:'numeric',minute:'2-digit'})}

['crew','me','members','venue','budget','home'].forEach(function(f){
 var el=$('#'+f);el.value=S[f];
 el.addEventListener('input',function(){S[f]=el.value;save();opts();split()})});
$('#anchor').addEventListener('change',function(e){S.anchor=e.target.value;save()});

function fill(sel,keep,list){
 sel.textContent='';
 if(!list.length){var o=document.createElement('option');o.value='';o.textContent='Add names above first';sel.appendChild(o);return ''}
 list.forEach(function(p){var o=document.createElement('option');o.value=p;o.textContent=p;sel.appendChild(o)});
 sel.value=list.indexOf(keep)>-1?keep:list[0];return sel.value}
function opts(){var l=people();S.anchor=fill($('#anchor'),S.anchor,l);fill($('#payer'),$('#payer').value,l);fill($('#by'),$('#by').value,l)}

var STEPS=[['arrived','Arrived'],['good','Still good'],['home',"I'm home"]];
function msg(k,t){var c=S.crew||'Crew Night',n=S.me||'I';
 if(k==='arrived')return '\u{1F319} '+c+': '+n+' arrived'+(S.venue?' at '+S.venue:'')+(S.kind?' for '+S.kind.toLowerCase():'')+' ('+t+').'+(S.home?' Home by '+S.home+'.':'');
 if(k==='good')return '\u2705 '+c+': '+n+' is still good ('+t+').';
 if(k==='all')return '\u{1F389} '+c+': everyone is home. Safe night number '+S.pts+'.';
 return '\u{1F3E0} '+c+': '+n+' is home safe ('+t+').'}
function offer(text){$('#msg').textContent=text;$('#wa').href='https://wa.me/?text='+encodeURIComponent(text);$('#out').style.display='block'}
function band(){var b=$('#band');b.textContent='';
 STEPS.forEach(function(s){var hit=S.log.filter(function(x){return x.k===s[0]}).pop();
  var el=document.createElement('button');el.type='button';el.className=hit?'done':'';
  el.appendChild(document.createTextNode(s[1]));var sm=document.createElement('small');sm.textContent=hit?hit.t:'Tap';el.appendChild(sm);
  el.addEventListener('click',function(){var t=now();S.log.push({k:s[0],t:t});save();band();offer(msg(s[0],t))});
  b.appendChild(el)});
 $('#pts').textContent=S.pts?('Safe nights: '+S.pts):''}
$('#all').addEventListener('click',function(){S.pts+=1;save();band();offer(msg('all',''))});
$('#copy').addEventListener('click',function(){var t=$('#msg').textContent,b=$('#copy');
 try{navigator.clipboard.writeText(t).then(function(){b.textContent='Copied'},function(){b.textContent='Copy failed'})}catch(e){b.textContent='Copy failed'}
 setTimeout(function(){b.textContent='Copy message'},1800)});
var armed=false;
$('#reset').addEventListener('click',function(){var b=$('#reset');
 if(!armed){armed=true;b.textContent='Tap again to clear this night';setTimeout(function(){armed=false;b.textContent='Start a new night'},3000);return}
 armed=false;S.log=[];S.exp=[];S.q=[];S.songs=[];save();b.textContent='Start a new night';$('#out').style.display='none';band();split();quests();songs();$('#pick').textContent=''});

$('#add').addEventListener('click',function(){
 var w=$('#what').value.trim(),a=parseFloat($('#amt').value),p=$('#payer').value;
 if(!w||!(a>0)||!p){$('#spent').textContent='Add what it was, an amount above zero, and who paid.';return}
 S.exp.push({w:w,a:a,p:p});save();$('#what').value='';$('#amt').value='';split()});

function split(){
 var l=people(),tot=S.exp.reduce(function(s,x){return s+x.a},0),bud=parseFloat(S.budget)||0;
 $('#spent').textContent=bud?('Spent '+kes(tot)+' of '+kes(bud)):(tot?'Spent '+kes(tot):'');
 var bar=$('#bar');bar.className='bar'+(bud&&tot>bud?' over':'');bar.firstChild.style.width=bud?Math.min(100,tot/bud*100)+'%':'0';
 var ul=$('#list');ul.textContent='';
 S.exp.forEach(function(x,i){var li=document.createElement('li'),s=document.createElement('span');
  s.textContent=x.w+' - '+x.p+' paid '+kes(x.a);li.appendChild(s);
  var d=document.createElement('button');d.type='button';d.textContent='Remove';
  d.addEventListener('click',function(){S.exp.splice(i,1);save();split()});li.appendChild(d);ul.appendChild(li)});
 var st=$('#settle');
 if(!S.exp.length){st.textContent='';return}
 if(l.length<2){st.textContent='Add your crew\u2019s names above to see who owes whom.';return}
 var share=tot/l.length,bal={};l.forEach(function(p){bal[p]=-share});
 S.exp.forEach(function(x){bal[x.p]=(bal[x.p]||0)+x.a});
 var deb=[],cre=[];Object.keys(bal).forEach(function(p){if(bal[p]<-1)deb.push([p,-bal[p]]);else if(bal[p]>1)cre.push([p,bal[p]])});
 var lines=[],i=0,j=0;
 while(i<deb.length&&j<cre.length){var m=Math.min(deb[i][1],cre[j][1]);
  lines.push(deb[i][0]+' pays '+cre[j][0]+' '+kes(m));deb[i][1]-=m;cre[j][1]-=m;
  if(deb[i][1]<1)i++;if(cre[j][1]<1)j++}
 st.textContent=lines.length?('Each person\u2019s share: '+kes(share)+'. '+lines.join('. ')+'.'):'Everyone is square.'}

var KINDS=['Club night','House party','Concert','Road trip','Food and chill'];
function kinds(){var b=$('#kinds');b.textContent='';
 KINDS.forEach(function(k){var c=document.createElement('button');c.type='button';c.className='chip'+(S.kind===k?' on':'');c.textContent=k;
  c.addEventListener('click',function(){S.kind=S.kind===k?'':k;save();kinds()});b.appendChild(c)})}

var QUESTS=['Take a crew photo when you arrive','Learn a dance move together','Request one song for the whole crew','Everyone drinks water at least once','Try one new spot or snack nearby','Everyone gets home by the same plan'];
function qp(){$('#qpts').textContent=S.qp?('Quest points: '+S.qp):''}
function quests(){var q=$('#quests');q.textContent='';
 QUESTS.forEach(function(t,i){var d=document.createElement('div');d.className='q';
  var c=document.createElement('input');c.type='checkbox';c.id='q'+i;c.checked=S.q.indexOf(i)>-1;
  var l=document.createElement('label');l.htmlFor='q'+i;l.textContent=t;
  c.addEventListener('change',function(){
   if(c.checked){S.q.push(i);S.qp+=1}else{S.q=S.q.filter(function(x){return x!==i});S.qp=Math.max(0,S.qp-1)}
   save();qp()});
  d.appendChild(c);d.appendChild(l);q.appendChild(d)});qp()}

var ROLES=['Anchor','Cab payer','Aux cord DJ','Photographer'];
(function(){var b=$('#roles');ROLES.forEach(function(r){var c=document.createElement('button');c.type='button';c.className='chip';c.textContent=r;
 c.addEventListener('click',function(){var l=people();
  if(l.length<2){$('#pick').textContent='Add your crew\u2019s names above first.';return}
  var w=l[Math.floor(Math.random()*l.length)];$('#pick').textContent=r+': '+w;
  offer('\u{1F3B2} '+(S.crew||'Crew Night')+': '+r+' is '+w+'.')});
 b.appendChild(c)})})();

function songs(){var u=$('#songs');u.textContent='';
 S.songs.forEach(function(x,i){var li=document.createElement('li'),s=document.createElement('span');
  s.textContent=x.s+' ('+x.by+')';li.appendChild(s);
  var d=document.createElement('button');d.type='button';d.textContent='Remove';
  d.addEventListener('click',function(){S.songs.splice(i,1);save();songs()});li.appendChild(d);u.appendChild(li)})}
$('#addsong').addEventListener('click',function(){var s=$('#song').value.trim(),by=$('#by').value;
 if(!s||!by)return;S.songs.push({s:s,by:by});save();$('#song').value='';songs()});
$('#shsong').addEventListener('click',function(){
 if(!S.songs.length)return;
 offer('\u{1F3B6} '+(S.crew||'Crew Night')+' song queue: '+S.songs.map(function(x,i){return (i+1)+'. '+x.s+' ('+x.by+')'}).join(' ')) });

opts();band();split();kinds();quests();songs();
})();
</script>
</body>
</html>
